<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="5dp"
    android:layout_marginVertical="15dp"
    android:background="@drawable/bg_comic_item"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/imgcomic_cover"
        android:layout_width="118dp"
        android:layout_height="172dp"
        android:layout_marginVertical="15dp"
        android:layout_marginLeft="15dp"
        app:srcCompat="@drawable/comic_background" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="156dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="15dp"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="5dp"
            android:fontFamily="@font/jersey25_regular"
            android:text="Title:"
            android:textAlignment="textStart"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/txtcomic_name"
            android:layout_width="156dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="15dp"
            android:text="Comic_name"
            android:textAlignment="textStart"
            android:textSize="16sp" />

        <TextView
            android:layout_width="156dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="15dp"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="5dp"
            android:fontFamily="@font/jersey25_regular"
            android:text="Author:"
            android:textAlignment="textStart"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/txt_authorcomicitem"
            android:layout_width="156dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="15dp"
            android:layout_marginBottom="15dp"
            android:text="Author_name"
            android:textAlignment="textStart"
            android:textSize="16sp" />

    </LinearLayout>
</LinearLayout>