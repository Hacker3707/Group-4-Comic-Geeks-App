<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginHorizontal="15dp">

    <!-- HEADER: cố định phía trên -->
    <LinearLayout
        android:id="@+id/linearLayout2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dialog_header_bg"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="15dp"
        android:paddingVertical="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnexitReviewdg"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_crossx"
            android:contentDescription="@string/common_close"
            android:scaleType="centerInside"
            app:tint="#FFFFFF" />

        <TextView
            android:id="@+id/txtvpostReview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="13dp"
            android:fontFamily="@font/jersey25_regular"
            android:text="@string/review_dialog_title"
            android:textColor="@color/white"
            android:textSize="22sp" />

        <ImageButton
            android:id="@+id/btnPopupMenuReview"
            android:layout_width="37dp"
            android:layout_height="35dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/m3_split_button_chevron_avd"
            android:contentDescription="@string/common_open_menu"
            android:scaleType="centerInside"
            app:tint="#FFFFFF" />

    </LinearLayout>

    <!-- BODY: vùng nội dung có thể cuộn -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollReviewBody"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_review_body"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:scrollbars="vertical"
        app:layout_constraintTop_toBottomOf="@id/linearLayout2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- USER INFO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#B1ADFD"
                android:paddingHorizontal="20dp"
                android:paddingVertical="15dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/imgAvtReview_dg"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:layout_marginEnd="12dp"
                        android:background="#FFFFFF"
                        android:contentDescription="@string/comic_reviewer_avatar_cd"
                        android:scaleType="centerCrop"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                        app:strokeColor="#FFFFFF"
                        app:strokeWidth="2dp" />

                    <TextView
                        android:id="@+id/txtReviewerName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/jersey25_regular"
                        android:text="Username"
                        android:textColor="#49316B"
                        android:textSize="20sp" />

                </LinearLayout>
            </LinearLayout>

            <!-- REVIEW FORM -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="16dp"
                android:paddingBottom="20dp">


                <!-- Rating label + rounded RatingBar box -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:layout_marginBottom="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Text nằm bên trái -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/jersey25_regular"
                        android:text="@string/review_rate_prompt"
                        android:textSize="18sp" />

                    <!-- Chỉ RatingBar được bo góc -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_review_content"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp">

                        <RatingBar
                            android:id="@+id/ratingBarReview"
                            style="@android:style/Widget.Material.RatingBar"
                            android:layout_width="246dp"
                            android:layout_height="55dp"
                            android:isIndicator="false"
                            android:numStars="5"
                            android:rating="0"
                            android:scaleX="0.8"
                            android:scaleY="0.8"
                            android:stepSize="0.5" />

                    </LinearLayout>

                </LinearLayout>


                <!-- REVIEW CONTENT LABEL -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jersey25_regular"
                    android:text="@string/review_words_prompt"
                    android:textSize="18sp" />

                <!-- REVIEW INPUT -->
                <EditText
                    android:id="@+id/etReviewcontent"
                    style="@style/Widget.Material3.AutoCompleteTextView.FilledBox"
                    android:layout_width="match_parent"
                    android:layout_height="121dp"
                    android:layout_marginVertical="10dp"
                    android:background="@drawable/bg_search"
                    android:gravity="top|start"
                    android:padding="10dp" />

                <!-- REVIEW DATE -->
                <TextView
                    android:id="@+id/txtReviewDate_dg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginVertical="5dp"
                    android:fontFamily="@font/jersey25_regular"
                    android:text="@string/review_date_label"
                    android:textAlignment="center"
                    android:textColor="@color/group_chip_text"
                    android:textSize="18sp"
                    android:paddingHorizontal="10dp"
                    android:visibility="gone" />

                <!-- VALIDATION MESSAGE -->
                <TextView
                    android:id="@+id/txtvGuide"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginVertical="5dp"
                    android:fontFamily="@font/jersey25_regular"
                    android:text="@string/review_guide"
                    android:textColor="@color/squidity_magenta"
                    android:textSize="18sp"
                    android:visibility="gone" />

                <!-- POST BUTTON -->
                <Button
                    android:id="@+id/btnpostReview"
                    android:layout_width="151dp"
                    android:layout_height="52dp"
                    android:layout_gravity="end"
                    android:layout_marginTop="10dp"
                    android:text="@string/review_post_button"
                    android:textSize="16sp" />

                <!-- EDIT / SAVE BUTTONS -->
                <LinearLayout
                    android:id="@+id/lnEditSaveReview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <Button
                        android:id="@+id/btneditReview"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:text="@string/common_edit"
                        android:textSize="16sp" />

                    <Button
                        android:id="@+id/btnSaveReview"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:text="@string/common_save"
                        android:textSize="16sp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
