<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/profileRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F4FA"
    android:fitsSystemWindows="false">

    <LinearLayout
        android:id="@+id/profileContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#F5F4FA">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/profileScrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="false"
            android:clipToPadding="false"
            android:scrollbars="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#A780EF"
                    android:paddingBottom="16dp">

                    <ImageView
                        android:id="@+id/imgProfileCover"
                        android:layout_width="0dp"
                        android:layout_height="180dp"
                        android:background="#FFB3C6"
                        android:contentDescription="@string/profile_cover_cd"
                        android:scaleType="centerCrop"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <!-- AVATAR CHỒNG LÊN BANNER -->
                    <ImageView
                        android:id="@+id/imgCoverGraffiti"
                        android:layout_width="0dp"
                        android:layout_height="250dp"
                        android:layout_marginTop="178dp"
                        android:contentDescription="@null"
                        android:elevation="1dp"
                        android:scaleType="fitXY"
                        android:src="@drawable/avt_backcover"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="0.0"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/imgProfileAvatar"
                        android:layout_width="150dp"
                        android:layout_height="150dp"
                        android:layout_marginTop="140dp"
                        android:background="#FFFFFF"
                        android:contentDescription="@string/common_avatar"
                        android:elevation="4dp"
                        android:outlineSpotShadowColor="#035D62"
                        android:padding="3dp"
                        android:scaleType="centerCrop"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="0.498"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                        app:strokeColor="#FFFFFF"
                        app:strokeWidth="3dp" />

                    <ImageButton
                        android:id="@+id/btnEditAvatarImage"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_profile_edit_button"
                        android:contentDescription="@string/profile_change_avatar"
                        android:src="@android:drawable/ic_menu_edit"
                        android:visibility="gone"
                        android:elevation="5dp"
                        app:layout_constraintBottom_toBottomOf="@id/imgProfileAvatar"
                        app:layout_constraintStart_toEndOf="@id/imgProfileAvatar"
                        app:tint="#493373" />

                    <ImageButton
                        android:id="@+id/btnEditCoverImage"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_margin="12dp"
                        android:background="@drawable/bg_profile_edit_button"
                        android:contentDescription="@string/profile_change_cover"
                        android:src="@android:drawable/ic_menu_edit"
                        android:visibility="gone"
                        app:layout_constraintEnd_toEndOf="@id/imgProfileCover"
                        app:layout_constraintTop_toTopOf="@id/imgProfileCover"
                        app:tint="#493373" />

                    <LinearLayout
                        android:id="@+id/profileNameRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:background="@drawable/bg_name_chip"
                        android:elevation="3dp"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="5dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/imgProfileAvatar">

                        <TextView
                            android:id="@+id/tvProfileName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="middle"
                            android:maxLines="1"
                            android:padding="10dp"
                            android:text="User Name"
                            android:textColor="#FFFFFF"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnEditProfile"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_marginStart="8dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:padding="0dp"
                            android:text="✎"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:visibility="gone"
                            app:backgroundTint="#8F69D8"
                            app:cornerRadius="15dp" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvProfileEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:fontFamily="@font/jersey25_regular"
                        android:text="email@example.com"
                        android:textColor="#666666"
                        android:textSize="19sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/profileNameRow" />

                    <LinearLayout
                        android:id="@+id/statsLayout"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginTop="24dp"
                        android:orientation="horizontal"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvProfileEmail">

                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="135dp"
                            android:layout_weight="1">

                            <ImageView
                                android:layout_width="160dp"
                                android:layout_height="160dp"
                                android:layout_gravity="center"
                                android:scaleType="fitCenter"
                                android:src="@drawable/paint_splash_left_newest" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center_horizontal"
                                android:orientation="vertical"
                                android:paddingVertical="35dp">

                                <TextView
                                    android:id="@+id/tvProfilePostCount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/jersey25_regular"
                                    android:text="0"
                                    android:textColor="#3246B4"
                                    android:textSize="30sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/jersey25_regular"
                                    android:text="@string/profile_posts"
                                    android:textColor="#3F51B5"
                                    android:textSize="17sp" />
                            </LinearLayout>

                        </FrameLayout>

                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="135dp"
                            android:layout_weight="1">

                            <ImageView
                                android:layout_width="160dp"
                                android:layout_height="160dp"
                                android:layout_gravity="center"
                                android:scaleType="fitCenter"
                                android:src="@drawable/paint_splash_mid" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center_horizontal"
                                android:orientation="vertical"
                                android:paddingVertical="35dp">

                                <TextView
                                    android:id="@+id/tvFollowersCount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/jersey25_regular"
                                    android:text="0"
                                    android:textColor="#FFFFFF"
                                    android:textSize="30sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/jersey25_regular"
                                    android:text="@string/profile_followers"
                                    android:textColor="#FFFFFF"
                                    android:textSize="17sp" />
                            </LinearLayout>

                        </FrameLayout>

                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="135dp"
                            android:layout_weight="1">

                            <ImageView
                                android:layout_width="160dp"
                                android:layout_height="160dp"
                                android:layout_gravity="center"
                                android:scaleType="fitCenter"
                                android:src="@drawable/paint_splash_right_new" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center_horizontal"
                                android:orientation="vertical"
                                android:paddingVertical="35dp">

                                <TextView
                                    android:id="@+id/tvFollowingCount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/jersey25_regular"
                                    android:text="0"
                                    android:textColor="#3F51B5"
                                    android:textSize="30sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/jersey25_regular"
                                    android:text="@string/profile_following"
                                    android:textColor="#3F51B5"
                                    android:textSize="17sp" />
                            </LinearLayout>

                        </FrameLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/profileActionButtons"
                        android:layout_width="match_parent"
                        android:layout_height="75dp"
                        android:layout_marginTop="20dp"
                        android:background="#7441AF"
                        android:gravity="center"
                        android:orientation="horizontal"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/statsLayout">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnFollow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/jersey25_regular"
                            android:text="@string/follow_button_follow"
                            android:textColor="#FFFFFF"
                            android:textSize="20sp"
                            app:backgroundTint="#7A6CFA"
                            app:cornerRadius="20dp"
                            tools:layout_marginRight="5dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnMessage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_marginLeft="5dp"
                            android:fontFamily="@font/jersey25_regular"
                            android:text="@string/profile_message"
                            android:textColor="#493373"
                            android:textSize="20sp"
                            app:backgroundTint="#FFFFFF"
                            app:cornerRadius="20dp" />

                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>


            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="22dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="#E0DCF0"
                app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:background="#FFFFFF">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/profile_signature"
                            android:textColor="#333333"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvProfileBio"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:text="@string/profile_bio_default"
                            android:textColor="#666666" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- FAVORITE GENRES CARD -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#E0DCF0"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:background="#FFFFFF">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/profile_fav_genres"
                            android:textColor="#333333"
                            android:textStyle="bold" />

                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:scrollbars="none">

                            <com.google.android.material.chip.ChipGroup
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:id="@+id/chipGroupProfile"
                                app:singleLine="true"
                                app:chipSpacingHorizontal="8dp"/>

                        </HorizontalScrollView>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/tabLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#FFFFFF"
                    app:tabIndicatorColor="#493373"
                    app:tabSelectedTextColor="#493373"
                    app:tabTextColor="#999999">

                    <com.google.android.material.tabs.TabItem
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_tab_about" />

                    <com.google.android.material.tabs.TabItem
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_tab_posts" />

                    <com.google.android.material.tabs.TabItem
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_tab_collection" />

                    <com.google.android.material.tabs.TabItem
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_tab_reviews" />

                </com.google.android.material.tabs.TabLayout>

                <LinearLayout
                    android:id="@+id/layoutIntroductionDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="#FFFFFF"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_personal_info"
                        android:textColor="#493373"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:paddingBottom="12dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_display_name"
                        android:textStyle="bold"
                        android:textColor="#777777" />

                    <TextView
                        android:id="@+id/tvIntroUsername"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/common_not_updated"
                        android:textColor="#333333"
                        android:paddingBottom="12dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/common_email"
                        android:textStyle="bold"
                        android:textColor="#777777" />

                    <TextView
                        android:id="@+id/tvIntroEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/common_not_updated"
                        android:textColor="#333333"
                        android:paddingBottom="12dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_gender"
                        android:textStyle="bold"
                        android:textColor="#777777" />

                    <TextView
                        android:id="@+id/tvIntroGender"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/common_not_updated"
                        android:textColor="#333333"
                        android:paddingBottom="12dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_birth_date"
                        android:textStyle="bold"
                        android:textColor="#777777" />

                    <TextView
                        android:id="@+id/tvIntroBirthDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/common_not_updated"
                        android:textColor="#333333"
                        android:paddingBottom="12dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_about_me"
                        android:textStyle="bold"
                        android:textColor="#777777" />

                    <TextView
                        android:id="@+id/tvIntroBio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_no_intro"
                        android:textColor="#333333"
                        android:paddingTop="6dp"
                        android:paddingBottom="16dp" />

                </LinearLayout>

                <!-- DANH SÁCH BÀI VIẾT -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerViewProfilePosts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#FFFFFF"
                    android:nestedScrollingEnabled="false"
                    android:paddingTop="8dp"
                    android:clipToPadding="false"
                    android:layout_marginBottom="80dp"
                    tools:listitem="@layout/activity_post" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </LinearLayout>


    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabCreatePost"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginRight="35dp"
        android:layout_marginBottom="35dp"
        android:contentDescription="@string/post_create_new"
        android:src="@android:drawable/ic_input_add"
        app:backgroundTint="#786FF8"
        app:elevation="6dp"
        app:fabCustomSize="65dp"
        app:fabSize="normal"
        app:tint="#FFFFFF" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
