<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chat_background"
    tools:context=".View.activity.ChatActivity">

    <LinearLayout
        android:id="@+id/layoutChatHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/chat_header"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnChatBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@string/common_back"
            android:padding="4dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/tvChatTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/jersey25_regular"
            android:maxLines="1"
            android:textColor="@color/white"
            android:textSize="22sp" />
        <ImageView
            android:id="@+id/btnChatMenu"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@string/chat_menu_cd"
            android:padding="4dp"
            android:src="@android:drawable/ic_menu_more"
            app:tint="@color/white" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvChatOffline"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/dm_bg_fff3cd"
        android:gravity="center"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:text="@string/chat_offline_banner"
        android:textColor="@color/dm_fg_7a5b00"
        android:textSize="13sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutChatHeader" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcvMessages"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="72dp"
        android:paddingVertical="4dp"
        app:layout_constraintBottom_toTopOf="@id/layoutChatInput"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvChatOffline" />

    <LinearLayout
        android:id="@+id/layoutChatInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingHorizontal="64dp"
        android:background="@color/dm_bg_ffffff"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageButton
            android:id="@+id/btnPickImage"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/chat_send_image"
            android:src="@android:drawable/ic_menu_gallery"
            app:tint="@color/chat_bubble_sent" />

        <EditText
            android:id="@+id/edtMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_chat_input"
            android:hint="@string/chat_say_something"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="4"
            android:minHeight="40dp"
            android:paddingHorizontal="16dp"
            android:textColor="@color/chat_text_dark"
            android:textColorHint="@color/chat_text_hint"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/btnSend"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/common_send"
            android:src="@android:drawable/ic_menu_send"
            app:tint="@color/chat_bubble_sent" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>