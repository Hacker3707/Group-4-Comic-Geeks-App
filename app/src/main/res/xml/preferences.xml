<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- ACCOUNT -->
    <PreferenceCategory
        android:key="category_account"
        android:layout="@layout/preference_setting_category"
        android:title="@string/pref_account">

        <Preference
            android:key="reset_password"
            android:icon="@drawable/ic_setting_lock"
            android:layout="@layout/preference_setting_item"
            android:summary="@string/pref_reset_password_summary"
            android:title="@string/pref_reset_password" />

        <Preference
            android:key="logout"
            android:icon="@drawable/ic_setting_logout"
            android:layout="@layout/preference_setting_item"
            android:summary="@string/pref_logout_summary"
            android:title="@string/pref_logout" />

    </PreferenceCategory>

    <!-- PREFERENCES -->
    <PreferenceCategory
        android:key="category_general"
        android:layout="@layout/preference_setting_category"
        android:title="@string/pref_preferences">

        <ListPreference
            android:key="language"
            android:defaultValue="en"
            android:entries="@array/language_entries"
            android:entryValues="@array/language_values"
            android:icon="@drawable/ic_setting_language"
            android:layout="@layout/preference_setting_item"
            android:title="@string/pref_language"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            android:key="theme"
            android:defaultValue="system"
            android:entries="@array/theme_entries"
            android:entryValues="@array/theme_values"
            android:icon="@drawable/ic_setting_palette"
            android:layout="@layout/preference_setting_item"
            android:title="@string/pref_theme"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            android:key="notifications_enabled"
            android:defaultValue="true"
            android:icon="@drawable/ic_setting_notifications"
            android:layout="@layout/preference_setting_plain"
            android:summary="@string/pref_notifications_summary"
            android:title="@string/pref_notifications"
            android:widgetLayout="@layout/preference_setting_switch_widget" />

        <Preference
            android:key="clear_cache"
            android:icon="@drawable/ic_setting_cache"
            android:layout="@layout/preference_setting_item"
            android:summary="@string/pref_clear_cache_summary"
            android:title="@string/pref_clear_cache" />

    </PreferenceCategory>

    <!-- PRIVACY -->
    <PreferenceCategory
        android:key="category_privacy"
        android:layout="@layout/preference_setting_category"
        android:title="@string/pref_privacy">

        <Preference
            android:key="blocked_users"
            android:icon="@drawable/ic_setting_block"
            android:layout="@layout/preference_setting_item"
            android:summary="@string/pref_blocked_summary"
            android:title="@string/pref_blocked" />

        <Preference
            android:key="privacy_policy"
            android:icon="@drawable/ic_setting_shield"
            android:layout="@layout/preference_setting_item"
            android:title="@string/pref_privacy_policy" />

    </PreferenceCategory>

    <!-- ABOUT -->
    <PreferenceCategory
        android:key="category_about"
        android:layout="@layout/preference_setting_category"
        android:title="@string/pref_about">

        <Preference
            android:key="help"
            android:icon="@drawable/ic_setting_help"
            android:layout="@layout/preference_setting_item"
            android:title="@string/pref_help" />

        <Preference
            android:key="app_version"
            android:icon="@drawable/ic_setting_version"
            android:layout="@layout/preference_setting_plain"
            android:selectable="false"
            android:summary="1.0.0"
            android:title="@string/pref_app_version" />

        <Preference
            android:key="app_info"
            android:icon="@drawable/ic_setting_info"
            android:layout="@layout/preference_setting_item"
            android:title="@string/pref_app_info" />

        <Preference
            android:key="app_license"
            android:icon="@drawable/ic_setting_license"
            android:layout="@layout/preference_setting_item"
            android:title="@string/pref_app_license" />

        <Preference
            android:key="app_credits"
            android:icon="@drawable/ic_setting_credits"
            android:layout="@layout/preference_setting_item"
            android:title="@string/pref_app_credits" />

    </PreferenceCategory>

    <!-- DANGER ZONE: tách riêng, nằm cuối để tránh bấm nhầm -->
    <PreferenceCategory
        android:key="category_danger"
        android:layout="@layout/preference_setting_category"
        android:title="@string/pref_danger_zone">

        <Preference
            android:key="delete_account"
            android:icon="@drawable/ic_setting_delete_account"
            android:layout="@layout/preference_setting_danger"
            android:summary="@string/pref_delete_summary"
            android:title="@string/pref_delete" />

    </PreferenceCategory>

</PreferenceScreen>
