<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:background="@color/dm_bg_f7f2fc"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Phần thông tin người đánh giá -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Avatar -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgAvtReview"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_gravity="top"
            android:layout_marginEnd="12dp"
            android:background="@color/dm_bg_ffffff"
            android:contentDescription="@string/comic_reviewer_avatar_cd"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
            app:strokeColor="@color/dm_stroke_ffffff"
            app:strokeWidth="2dp" />

        <!-- Tên, sao và ngày đánh giá -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

            <TextView
                android:id="@+id/txtReviewerName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Username"
                android:textColor="@color/dm_fg_49316b"
                android:textSize="16sp"
                android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtReviewAddition_pf"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:text="@string/comic_posted_review"
                    android:visibility="gone" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/lnly_reviewProfile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipLinkedComic_pf"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="16dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/jersey25_regular"
                    android:maxWidth="280dp"
                    android:maxLines="1"
                    android:text="@string/post_linked_comic"
                    android:textColor="@color/dm_fg_493373"
                    android:textSize="16sp"
                    android:visibility="visible"
                    app:chipBackgroundColor="@color/dm_bg_eee7ff"
                    app:chipCornerRadius="16dp"
                    app:chipIconVisible="false"
                    app:chipMinHeight="36dp"
                    app:chipStrokeColor="@color/dm_stroke_d2c3ff"
                    app:chipStrokeWidth="1dp"
                    app:closeIconVisible="false" />

                <RatingBar
                    android:id="@+id/ratingBarReview_pf"
                    style="@style/Widget.AppCompat.RatingBar.Indicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="4dp"
                    android:isIndicator="true"
                    android:numStars="5"
                    android:rating="0"
                    android:stepSize="0.1" />

            </LinearLayout>

            <RatingBar
                android:id="@+id/ratingBarReview"
                style="?android:attr/ratingBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:isIndicator="true"
                android:numStars="5"
                android:rating="0"
                android:stepSize="0.5" />


        </LinearLayout>

    </LinearLayout>

    <!-- Nội dung review -->
    <TextView
        android:id="@+id/txtReviewContent"
        style="@style/Widget.AppCompat.TextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="58dp"
        android:layout_marginTop="12dp"
        android:text="Review content..."
        android:textColor="@color/dm_fg_29212f"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/txtReviewDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="15/10/2026"
        android:textColor="@color/dm_fg_77717f"
        android:textSize="12sp"
        android:layout_gravity="end"/>

</LinearLayout>