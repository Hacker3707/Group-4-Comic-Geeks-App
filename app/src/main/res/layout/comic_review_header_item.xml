<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Thông tin truyện -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/imgComicCover"
            android:layout_width="160dp"
            android:layout_height="220dp"
            android:background="@drawable/bg_comic_small_card"
            android:contentDescription="Comic cover"
            android:scaleType="centerCrop"
            android:src="@drawable/comic_background" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="15dp"
            android:layout_weight="1"
            android:orientation="vertical"
            tools:layout_marginTop="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/jersey25_regular"
                android:text="Title"
                android:textColor="#49316B"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/txtComicName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Comic name"
                android:textColor="#29212F"
                android:textSize="17sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/jersey25_regular"
                android:text="Ratings:"
                android:textColor="#49316B"
                android:textSize="20sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <RatingBar
                    android:id="@+id/ratingBar"
                    style="@style/Widget.AppCompat.RatingBar.Indicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:isIndicator="true"
                    android:numStars="5"
                    android:rating="0"
                    android:stepSize="0.1" />

            </LinearLayout>

            <TextView
                android:id="@+id/txtComicRating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Not rated yet"
                android:textColor="#49316B"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnwriteReview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginTop="10dp"
                android:text="Review it here!" />

        </LinearLayout>
    </LinearLayout>

    <!-- Bộ lọc review -->
    <Spinner
        android:id="@+id/spinnerReviewFilter"
        android:layout_width="match_parent"
        android:layout_height="35dp"
        android:layout_marginTop="20dp" />

</LinearLayout>
