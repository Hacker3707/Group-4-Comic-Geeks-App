<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Thông tin truyện -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="5dp"
        android:background="@color/dm_bg_ffffff"
        android:gravity="top"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:id="@+id/imgComicCover"
            android:layout_width="160dp"
            android:layout_height="220dp"
            android:layout_marginLeft="5dp"
            android:background="@drawable/bg_comic_small_card"
            android:contentDescription="@string/comic_cover_cd"
            android:scaleType="centerCrop"
            android:src="@drawable/comic_background" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="15dp"
            android:layout_weight="1"
            android:orientation="vertical"
            tools:layout_marginTop="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/jersey25_regular"
                android:text="@string/comic_title_label"
                android:textColor="@color/dm_fg_49316b"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/txtComicName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Comic name"
                android:textColor="@color/dm_fg_29212f"
                android:textSize="17sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/jersey25_regular"
                android:text="@string/comic_ratings_colon"
                android:textColor="@color/dm_fg_49316b"
                android:textSize="20sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RatingBar
                    android:id="@+id/ratingBar"
                    style="@style/Widget.AppCompat.RatingBar.Indicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:isIndicator="true"
                    android:numStars="5"
                    android:rating="0"
                    android:stepSize="0.1" />

            </LinearLayout>

            <TextView
                android:id="@+id/txtComicRating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/comic_not_rated"
                android:textColor="@color/dm_fg_49316b"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnwriteReview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginTop="10dp"
                android:text="@string/comic_review_here" />

        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/dm_bg_c1a5f8"
        android:padding="10dp">

        <!-- Bộ lọc review -->
        <Spinner
            android:id="@+id/spinnerReviewFilter"
            android:layout_width="match_parent"
            android:layout_height="35dp"
            android:background="@color/dm_bg_ffffff" />

    </LinearLayout>

</LinearLayout>
