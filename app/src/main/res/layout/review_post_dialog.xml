<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="15dp">

    <LinearLayout
        android:id="@+id/linearLayout2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dialog_header_bg"
        android:orientation="horizontal"
        android:paddingHorizontal="15dp"
        android:paddingVertical="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnexitReviewdg"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_marginTop="2dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_crossx"
            app:layout_constraintStart_toStartOf="parent"
            app:tint="#FFFFFF" />

        <TextView
            android:id="@+id/txtvpostReview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="10dp"
            android:layout_marginLeft="13dp"
            android:layout_weight="1"
            android:fontFamily="@font/jersey25_regular"
            android:text="@string/review_dialog_title"
            android:textColor="@color/white"
            android:textSize="22sp"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/btnPopupMenuReview"
            android:layout_width="37dp"
            android:layout_height="35dp"
            android:layout_marginTop="5dp"
            android:src="@drawable/m3_split_button_chevron_avd"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/common_open_menu"
            android:scaleType="centerInside"
            app:tint="#FFFFFF" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_review_body"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout2">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/dm_bg_b1adfd"
            android:paddingHorizontal="20dp"
            android:paddingVertical="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Avatar -->
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imgAvtReview_dg"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginEnd="12dp"
                    android:background="@color/dm_bg_ffffff"
                    android:contentDescription="@string/comic_reviewer_avatar_cd"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                    app:strokeColor="@color/dm_stroke_ffffff"
                    app:strokeWidth="2dp" />

                <!-- Tên, sao và ngày đánh giá -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtReviewerName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/jersey25_regular"
                        android:text="Username"
                        android:textColor="@color/dm_fg_49316b"
                        android:textSize="20sp" />

                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingVertical="13dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:fontFamily="@font/jersey25_regular"
                android:text="@string/review_rate_prompt"
                android:textSize="18sp" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="15dp"
                android:layout_marginVertical="15dp"
                android:background="@drawable/bg_review_content">


                <RatingBar
                    android:id="@+id/ratingBarReview"
                    style="@android:style/Widget.Material.RatingBar"
                    android:layout_width="236dp"
                    android:layout_height="50dp"
                    android:isIndicator="false"
                    android:numStars="5"
                    android:rating="0"
                    android:stepSize="0.5"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/jersey25_regular"
                android:text="@string/review_words_prompt"
                android:textSize="18sp" />

            <EditText
                android:id="@+id/etReviewcontent"
                style="@style/Widget.Material3.AutoCompleteTextView.FilledBox"
                android:layout_width="match_parent"
                android:layout_height="121dp"
                android:layout_marginVertical="10dp"
                android:background="@drawable/bg_search"
                android:padding="5dp"/>

            <TextView
                android:id="@+id/txtReviewDate_dg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginVertical="5dp"
                android:fontFamily="@font/jersey25_regular"
                android:text="@string/review_date_label"
                android:textAlignment="center"
                android:textColor="@color/group_chip_text"
                android:textSize="18sp"
                android:paddingHorizontal="10dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txtvGuide"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginVertical="5dp"
                android:fontFamily="@font/jersey25_regular"
                android:text="@string/review_guide"
                android:textColor="@color/squidity_magenta"
                android:textSize="18sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnpostReview"
                android:layout_width="151dp"
                android:layout_height="52dp"
                android:layout_gravity="end"
                android:layout_marginTop="10dp"
                android:text="@string/review_post_button"
                android:textSize="16sp" />

            <LinearLayout
                android:id="@+id/lnEditSaveReview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="10dp"
                android:visibility="gone">

                <Button
                    android:id="@+id/btneditReview"
                    android:layout_width="151dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="10dp"
                    android:text="@string/common_edit"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btnSaveReview"
                    android:layout_width="151dp"
                    android:layout_height="52dp"
                    android:text="@string/common_save"
                    android:textSize="16sp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>