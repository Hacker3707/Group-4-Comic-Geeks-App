<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="20dp"
    android:layout_marginTop="16dp"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:strokeColor="#E0DCF0"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF">

        <!-- HEADER: bọc 2 kiểu header, chỉ 1 kiểu hiện tại một thời điểm -->
        <FrameLayout
            android:id="@+id/headerContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent">

            <!-- HEADER: viền mực chảy + thông tin user & nút tùy chọn -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/headerLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent">

                <!-- Nền tím có vệt mực chảy nhỏ giọt (tỉ lệ 374:123) -->
                <ImageView
                    android:id="@+id/imgHeaderWave"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:src="@drawable/post_card_wave"
                    app:layout_constraintDimensionRatio="385:133"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/btnOptions"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="32dp"
                    android:src="@android:drawable/ic_menu_more"
                    app:tint="#FFFFFF"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <Button
                    android:id="@+id/btnFollow"
                    android:layout_width="82dp"
                    android:layout_height="35dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="27dp"
                    android:backgroundTint="#33FFFFFF"
                    android:ellipsize="none"
                    android:fontFamily="@font/jersey25_regular"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:singleLine="true"
                    android:text="+ Follow"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    app:cornerRadius="16dp"
                    app:layout_constraintStart_toEndOf="@id/btnOptions"
                    app:layout_constraintTop_toTopOf="parent" />

                <LinearLayout
                    android:id="@+id/userInfoLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginEnd="10dp"
                    android:gravity="end"
                    android:orientation="vertical"
                    app:layout_constraintEnd_toStartOf="@id/imgAvatar"
                    app:layout_constraintStart_toEndOf="@id/btnFollow"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:id="@+id/tvUserName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/inter_bold"
                        android:maxLines="1"
                        android:text="Manga Lover 101"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tvHandle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/inter_regular"
                        android:maxLines="1"
                        android:text="\@squidiscute"
                        android:textColor="@color/group_post_handle"
                        android:textSize="12sp" />
                </LinearLayout>

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imgAvatar"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginEnd="16dp"
                    android:background="#A890D3"
                    android:scaleType="centerCrop"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                    app:strokeColor="#FFFFFF"
                    app:strokeWidth="2dp" />

            </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- HEADER KIỂU GROUP: cũng có vệt mực chảy, avatar nhóm + avatar người đăng nhỏ -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/groupHeaderLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone">

                        <ImageView
                            android:id="@+id/imgGroupHeaderWave"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:importantForAccessibility="no"
                            android:scaleType="fitXY"
                            android:src="@drawable/post_card_wave"
                            app:layout_constraintDimensionRatio="374:123"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <ImageView
                            android:id="@+id/btnGroupOptions"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginStart="16dp"
                            android:layout_marginTop="32dp"
                            android:src="@android:drawable/ic_menu_more"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:tint="#FFFFFF" />

                        <FrameLayout
                            android:id="@+id/groupAvatarStack"
                            android:layout_width="54dp"
                            android:layout_height="54dp"
                            android:layout_marginTop="18dp"
                            android:layout_marginEnd="12dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/imgGroupAvatar"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:layout_gravity="top|start"
                                android:background="#A890D3"
                                android:contentDescription="@string/group_cd_avatar"
                                android:scaleType="centerCrop"
                                app:shapeAppearanceOverlay="@style/PostGroupAvatarShape" />

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/imgGroupPosterAvatar"
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:layout_gravity="bottom|end"
                                android:background="#A890D3"
                                android:contentDescription="@string/group_cd_avatar"
                                android:scaleType="centerCrop"
                                app:shapeAppearanceOverlay="@style/GroupCircleImage"
                                app:strokeColor="#2E2879"
                                app:strokeWidth="2dp" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_marginTop="24dp"
                            android:layout_marginEnd="8dp"
                            android:gravity="end"
                            android:orientation="vertical"
                            app:layout_constraintEnd_toStartOf="@id/groupAvatarStack"
                            app:layout_constraintStart_toEndOf="@id/btnGroupOptions"
                            app:layout_constraintTop_toTopOf="parent">

                            <TextView
                                android:id="@+id/tvGroupName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:fontFamily="@font/inter_bold"
                                android:maxLines="1"
                                android:textColor="#FFFFFF"
                                android:textSize="15sp" />

                            <TextView
                                android:id="@+id/tvGroupPoster"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="end"
                                android:fontFamily="@font/inter_regular"
                                android:maxLines="1"
                                android:textColor="@color/group_post_handle"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>

        </FrameLayout>

        <!-- NỘI DUNG BÀI VIẾT -->
        <TextView
            android:id="@+id/tvPostContent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="-12dp"
            android:elevation="2dp"
            android:fontFamily="@font/mozilla_headline"
            android:text="Opinion on this manga ..."
            android:textColor="#333333"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/headerContainer" />


        <!-- LƯỚI ẢNH BÀI VIẾT -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPostImages"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:nestedScrollingEnabled="false"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:spanCount="2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvPostContent" />

        <LinearLayout
            android:id="@+id/actionLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            app:layout_constraintTop_toBottomOf="@id/rvPostImages"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/tvHashtag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableEnd="@android:drawable/ic_menu_edit"
                android:drawablePadding="4dp"
                android:fontFamily="@font/jersey25_regular"
                android:text="# Discussion"
                android:textColor="#2F2148"
                android:textSize="20sp"
                android:textStyle="normal" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvCommentCount"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginEnd="16dp"
                android:drawableEnd="@android:drawable/sym_action_chat"
                android:drawablePadding="4dp"
                android:text="1" />

            <ImageView
                android:id="@+id/btnStamp"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_splash_unfill" />

        </LinearLayout>

        <!-- CHIP COMIC: HÀNG RIÊNG BÊN DƯỚI -->
        <com.google.android.material.chip.Chip
            android:id="@+id/tvLinkedComic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="16dp"
            android:fontFamily="@font/jersey25_regular"
            android:text="📖 Linked Comic"
            android:textColor="#493373"
            android:textSize="16sp"
            android:visibility="gone"
            android:maxLines="1"
            android:ellipsize="end"
            android:maxWidth="280dp"

        app:chipBackgroundColor="#EEE7FF"
        app:chipCornerRadius="16dp"
        app:chipIconVisible="false"
        app:chipMinHeight="36dp"
        app:chipStrokeColor="#D2C3FF"
        app:chipStrokeWidth="1dp"
        app:closeIconVisible="false"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/actionLayout" />

        <!-- DIVIDER -->
        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:background="#E0E0E0"
            app:layout_constraintTop_toBottomOf="@id/tvLinkedComic"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


        <!-- Ô BÌNH LUẬN NHANH -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F9F9F9"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="17dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divider">

            <EditText
                android:id="@+id/edtQuickComment"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:fontFamily="@font/mozilla_headline"
                android:hint="Say something...くコ:彡"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/btnSendComment"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_send"
                app:tint="#493373" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>