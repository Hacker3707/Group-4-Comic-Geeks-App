<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/group_header"
    android:orientation="vertical"
    tools:context=".View.activity.CreateGroupActivity">

    <!-- Thanh tiêu đề -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/group_header"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="8dp">

        <ImageView
            android:id="@+id/imgBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/group_cd_back"
            android:padding="8dp"
            android:src="@drawable/ic_group_back"
            app:tint="@color/white" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="@font/jersey25_regular"
            android:text="@string/create_group_title"
            android:textColor="@color/white"
            android:textSize="24sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/white"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="17dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold"
                android:text="@string/create_group_name_label"
                android:textColor="@color/group_name"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/edtGroupName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_group_composer"
                android:fontFamily="@font/inter"
                android:hint="@string/create_group_name_hint"
                android:importantForAutofill="no"
                android:inputType="textCapWords"
                android:maxLines="1"
                android:padding="12dp"
                android:textColor="@color/group_text"
                android:textColorHint="@color/group_composer_hint"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/inter_bold"
                android:text="@string/create_group_desc_label"
                android:textColor="@color/group_name"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/edtGroupDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_group_composer"
                android:fontFamily="@font/inter"
                android:gravity="top|start"
                android:hint="@string/create_group_desc_hint"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="4"
                android:padding="12dp"
                android:textColor="@color/group_text"
                android:textColorHint="@color/group_composer_hint"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/inter_bold"
                android:text="@string/create_group_cover_label"
                android:textColor="@color/group_name"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/edtCoverUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_group_composer"
                android:fontFamily="@font/inter"
                android:hint="@string/create_group_cover_hint"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:maxLines="1"
                android:padding="12dp"
                android:textColor="@color/group_text"
                android:textColorHint="@color/group_composer_hint"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/inter_bold"
                android:text="@string/create_group_avatar_label"
                android:textColor="@color/group_name"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/edtAvatarUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_group_composer"
                android:fontFamily="@font/inter"
                android:hint="@string/create_group_cover_hint"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:maxLines="1"
                android:padding="12dp"
                android:textColor="@color/group_text"
                android:textColorHint="@color/group_composer_hint"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnCreateGroup"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_group_join_button"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/jersey25_regular"
                android:gravity="center"
                android:text="@string/create_group_submit"
                android:textColor="@color/white"
                android:textSize="20sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
