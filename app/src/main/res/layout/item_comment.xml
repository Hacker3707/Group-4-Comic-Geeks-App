<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="8dp">

    <!-- Avatar người bình luận -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imgCommentAvatar"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@color/dm_bg_d1c4e9"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Khung bong bóng chứa Tên, Nội dung và phần Trả lời -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/comment_input_bg"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@id/imgCommentAvatar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Tên người dùng -->
        <TextView
            android:id="@+id/tvCommentUsername"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/comment_user_placeholder"
            android:textStyle="bold"
            android:textColor="@color/dm_fg_333333"
            android:textSize="13sp" />

        <!-- 👉 Nhãn hiển thị thông tin đang trả lời ai (Ví dụ: Trả lời @username) -->
        <TextView
            android:id="@+id/tvReplyInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/comment_reply_placeholder"
            android:textColor="#7E57C2"
            android:textSize="12sp"
            android:textStyle="italic"
            android:visibility="gone"
            android:layout_marginTop="2dp" />

        <!-- Nội dung bình luận -->
        <TextView
            android:id="@+id/tvCommentContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/comment_content_placeholder"
            android:textColor="@color/dm_fg_444444"
            android:layout_marginTop="4dp"
            android:textSize="14sp" />

        <!-- 👉 Nút bấm "Trả lời" nằm ngay dưới nội dung comment -->
        <TextView
            android:id="@+id/btnReplyComment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/comment_reply_btn"
            android:textColor="#5E35B1"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="?attr/selectableItemBackground"
            android:paddingTop="4dp"
            android:paddingBottom="2dp"
            android:layout_marginTop="4dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>