<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="28dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="156dp"
            android:background="@drawable/bg_auth_wave">

            <ImageButton
                android:id="@+id/btnAuthBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="top|start"
                android:layout_marginStart="12dp"
                android:layout_marginTop="16dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Quay lại"
                android:padding="12dp"
                android:src="@drawable/ic_group_back"
                app:tint="#FFFFFF" />

            <TextView
                android:id="@+id/tvAuthHeaderTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="25dp"
                android:fontFamily="@font/jersey25_regular"
                android:gravity="center"
                android:text="SIGN IN"
                android:textColor="#FFFFFF"
                android:textSize="30sp"
                android:textStyle="bold" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="35dp"
            android:paddingEnd="35dp"
            android:paddingTop="7dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="25dp"
                android:fontFamily="@font/jersey25_regular"
                android:text="Squidity"
                android:textColor="#090909"
                android:textSize="34sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/usernameContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="Họ và tên"
                    android:textColor="#111111"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etUsername"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginBottom="9dp"
                    android:background="@drawable/bg_auth_input"
                    android:hint="Nhập tên của bạn"
                    android:inputType="textPersonName"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:singleLine="true"
                    android:textColor="#191919"
                    android:textColorHint="#999999"
                    android:textSize="13sp" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Email"
                android:textColor="#111111"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_auth_input"
                android:hint="you@example.com"
                android:inputType="textEmailAddress"
                android:paddingStart="13dp"
                android:paddingEnd="13dp"
                android:singleLine="true"
                android:textColor="#191919"
                android:textColorHint="#999999"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Password"
                android:textColor="#111111"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginBottom="9dp"
                android:background="@drawable/bg_auth_input"
                android:hint="Mật khẩu"
                android:inputType="textPassword"
                android:paddingStart="13dp"
                android:paddingEnd="13dp"
                android:singleLine="true"
                android:textColor="#191919"
                android:textColorHint="#999999"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/confirmPasswordContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="Xác nhận mật khẩu"
                    android:textColor="#111111"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etConfirmPassword"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_auth_input"
                    android:hint="Xác nhận mật khẩu"
                    android:inputType="textPassword"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:singleLine="true"
                    android:textColor="#191919"
                    android:textColorHint="#999999"
                    android:textSize="13sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvAuthTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvAuthSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvAuthStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:textColor="#C62828"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvModeToggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:gravity="end"
                android:paddingTop="13dp"
                android:paddingBottom="10dp"
                android:text="Chưa có tài khoản? Đăng ký"
                android:textColor="#B66BE5"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAuthSubmit"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:fontFamily="@font/jersey25_regular"
                android:text="SIGN IN"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                app:backgroundTint="#8B70F5"
                app:cornerRadius="10dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:gravity="center"
                android:text="— hoặc —"
                android:textColor="#A6A6A6"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGoogleSignIn"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="Đăng nhập bằng Google"
                android:textAllCaps="false"
                android:textColor="#33264A"
                android:textSize="14sp"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="10dp"
                app:icon="@drawable/ic_google_g"
                app:iconGravity="textStart"
                app:iconTint="@null"
                app:strokeColor="#222222"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExitToLogin"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="12dp"
                android:text="Thoát ra màn hình đăng nhập"
                android:textAllCaps="false"
                android:textColor="#33264A"
                android:textSize="14sp"
                android:visibility="gone"
                app:backgroundTint="#F2F2F7"
                app:cornerRadius="10dp"
                app:strokeColor="#CCCCCC"
                app:strokeWidth="1dp" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>