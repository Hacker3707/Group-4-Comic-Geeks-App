<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#000000">

    <!-- Ảnh phóng to (Hỗ trợ cuộn/thu phóng nếu dùng thư viện hoặc ImageView scaleType) -->


    <ImageView
        android:id="@+id/imgZoomed"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Ảnh phóng to"
        android:scaleType="fitCenter" />

    <ImageButton
        android:id="@+id/btnCloseZoom"
        android:layout_width="40dp"
        android:layout_height="43dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="361dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="41dp"
        android:layout_marginEnd="10dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Đóng"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        app:tint="#FFFFFF" />

</RelativeLayout>