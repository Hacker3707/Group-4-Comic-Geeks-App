<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:fitsSystemWindows="true">

    <!-- APP BAR DÙNG CHUNG CỦA NHÓM TRƯỞNG -->
    <include
        android:id="@+id/appBar"
        layout="@layout/layout_app_bar"
        android:layout_width="match_parent"
        android:layout_height="70dp" />

    <!-- HÀNG THAO TÁC: HỦY VÀ ĐĂNG -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="#FFFFFF">

        <ImageButton
            android:id="@+id/btnCancelPost"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Hủy tạo bài viết"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="#493373"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tạo bài viết"
            android:textColor="#493373"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/btnCancelPost"
            app:layout_constraintEnd_toStartOf="@id/btnPublish"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPublish"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:text="ĐĂNG"
            android:textColor="#493373"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="#FFB3C6"
            app:cornerRadius="18dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E8E3EF" />

    <!-- NỘI DUNG NHẬP BÀI VIẾT -->
    <EditText
        android:id="@+id/edtPostContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@android:color/transparent"
        android:gravity="top|start"
        android:padding="16dp"
        android:hint="Bạn đang nghĩ gì về bộ truyện này?"
        android:textColor="#333333"
        android:textColorHint="#999999"
        android:textSize="16sp"
        android:inputType="textCapSentences|textMultiLine"
        android:scrollbars="vertical"
        android:overScrollMode="ifContentScrolls" />

    <!-- Ô NHẬP TÊN TRUYỆN ĐỂ KẾT NỐI API (ĐÃ ĐƯA RA NGOÀI ĐÚNG VỊ TRÍ) -->
    <EditText
        android:id="@+id/edtComicSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_search"
        android:padding="12dp"
        android:hint="Nhập tên bộ truyện (để liên kết API)..."
        android:textColor="#333333"
        android:textSize="14sp" />

    <!-- KHUNG XEM TRƯỚC ẢNH -->
    <ImageView
        android:id="@+id/imgPreview"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:scaleType="centerCrop"
        android:visibility="gone"
        android:background="#EEEEEE"
        android:contentDescription="Xem trước ảnh" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0" />

    <!-- NÚT CHỌN ẢNH -->
    <LinearLayout
        android:id="@+id/btnAddImage"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="#F9F9F9"
        android:gravity="center_vertical"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Thêm ảnh vào bài viết">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@android:drawable/ic_menu_camera"
            android:contentDescription="@null"
            app:tint="#493373" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Thêm ảnh vào bài viết"
            android:textColor="#493373"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>