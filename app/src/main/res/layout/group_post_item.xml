<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:background="@drawable/bg_group_post_card">

    <!-- Viền tím chảy nhỏ giọt ở đầu thẻ (tỉ lệ 374:123 như Figma) -->
    <ImageView
        android:id="@+id/imgWave"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/post_card_wave"
        app:layout_constraintDimensionRatio="374:123"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txtPostDots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="28dp"
        android:text="@string/group_post_dots"
        android:textColor="@color/white"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imgPostAvatar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="16dp"
        android:contentDescription="@string/group_cd_avatar"
        android:scaleType="centerCrop"
        android:src="@drawable/group_avatar_sample"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/GroupCircleImage" />

    <TextView
        android:id="@+id/txtAuthorName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="60dp"
        android:layout_marginEnd="10dp"
        android:ellipsize="end"
        android:fontFamily="@font/jersey25_regular"
        android:gravity="end"
        android:maxLines="1"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:layout_constraintEnd_toStartOf="@id/imgPostAvatar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/imgPostAvatar" />

    <TextView
        android:id="@+id/txtAuthorHandle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="60dp"
        android:layout_marginEnd="10dp"
        android:ellipsize="end"
        android:fontFamily="@font/jersey25_regular"
        android:gravity="end"
        android:maxLines="1"
        android:textColor="@color/group_post_handle"
        android:textSize="16sp"
        app:layout_constraintEnd_toStartOf="@id/imgPostAvatar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtAuthorName" />

    <TextView
        android:id="@+id/txtContent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        android:layout_marginTop="-14dp"
        android:layout_marginEnd="22dp"
        android:fontFamily="@font/kode_mono_regular"
        android:textColor="@color/black"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imgWave" />

    <ImageView
        android:id="@+id/imgHash"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginStart="22dp"
        android:layout_marginTop="18dp"
        android:contentDescription="@string/group_cd_topic"
        android:src="@drawable/ic_group_hash"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtContent"
        app:tint="@color/group_post_topic" />

    <TextView
        android:id="@+id/txtTopic"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:fontFamily="@font/inter_bold"
        android:text="@string/group_post_topic"
        android:textColor="@color/group_post_topic"
        android:textSize="13sp"
        app:layout_constraintBottom_toBottomOf="@id/imgHash"
        app:layout_constraintStart_toEndOf="@id/imgHash"
        app:layout_constraintTop_toTopOf="@id/imgHash" />

    <ImageView
        android:id="@+id/imgInk"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="22dp"
        android:importantForAccessibility="no"
        android:src="@drawable/post_ink_splat"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtContent" />

    <TextView
        android:id="@+id/txtSay"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="22dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_group_post_card"
        android:fontFamily="@font/jersey25_regular"
        android:padding="14dp"
        android:text="@string/group_post_say"
        android:textColor="@color/group_post_say"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imgInk" />
</androidx.constraintlayout.widget.ConstraintLayout>
