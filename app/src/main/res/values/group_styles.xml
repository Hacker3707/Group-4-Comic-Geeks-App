<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Bo tròn ảnh đại diện (dùng với ShapeableImageView) -->
    <style name="GroupCircleImage" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Chữ ở các tab của TabLayout -->
    <style name="GroupTabText" parent="TextAppearance.Design.Tab">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">12sp</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="GroupTabTextSelected" parent="GroupTabText">
        <item name="android:fontFamily">@font/inter_bold</item>
    </style>
</resources>
